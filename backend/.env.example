# Application
APP_NAME=ShortDram Studio
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=sqlite:///./shortdram.db
# PostgreSQL 示例:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/shortdram

# Encryption - 用于加密存储 LLM API Key
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-here

# LangSmith (可选，用于智能体追踪)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=shortdram-studio
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Logging
LOG_LEVEL=info
